# Copy to .env and fill in real values. Never commit .env.

PORT=3001

# Shared secret required (Authorization: Bearer <token>) by every write endpoint.
# Leave empty and all writes are rejected. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGI_API_TOKEN=

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=agi_research
DATABASE_USER=agi_app
DATABASE_PASSWORD=

# Runner: calls the Anthropic API and costs money. Disabled unless "true".
RUNNER_ENABLED=false
RUNNER_MAX_RUNS_PER_HOUR=20
ANTHROPIC_API_KEY=
